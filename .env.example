# University Directory Service - example environment.
# Copy to .env and fill in real values locally. Never commit .env.
# Every value below is a placeholder, not a working credential.

# Database (SQLite by default; any SQLAlchemy URL works)
DATABASE_URL=sqlite:///./directory.db

# Identity Service HTTP API (no trailing slash). Used for token signing keys
# (JWKS), user checks and live role confirmation.
# In Docker Compose use the service name, e.g. http://identity-service:8001
IDENTITY_SERVICE_BASE_URL=http://identity-service.example:8001
IDENTITY_TIMEOUT_CONNECT=3
IDENTITY_TIMEOUT_READ=5

# Token verification mode:
#   jwks            default; Identity API contract v1 (RS256 + JWKS, iss/aud
#                   checked, roles from the token's "roles" claim)
#   identity-hs256  legacy; only for the Sprint 1 Identity Service that signed
#                   HS256 tokens with a shared secret
AUTH_MODE=jwks

# jwks mode. Defaults match the Identity API contract v1; override only if it changes.
JWT_ISSUER=university-identity-service
JWT_AUDIENCE=university-services-platform
# Optional; defaults to {IDENTITY_SERVICE_BASE_URL}/.well-known/jwks.json
JWKS_URL=
JWKS_CACHE_TTL_SECONDS=300

# identity-hs256 (legacy) mode only: must equal the Identity Service's secret.
# Leave empty in jwks mode.
JWT_SECRET_KEY=
